# Security & Search Optimization Headers for https://phuahhongxuan.com
DirectoryIndex index.html

<IfModule mod_headers.c>
    # Prevent framing, embedding, clickjacking and iframe cloning
    Header set X-Frame-Options "DENY"
    Header set Content-Security-Policy "frame-ancestors 'none';"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Allow indexing and rich snippets for Search & AI Answer Engines
    Header set X-Robots-Tag "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
</IfModule>

# Block malicious offline rippers and brute scrapers with HTTP 403 Forbidden
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_USER_AGENT} (HTTrack|Wget|Scrapy) [NC]
    RewriteRule .* - [F,L]
</IfModule>
